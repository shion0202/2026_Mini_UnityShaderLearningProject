%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1772c30946e18c5488471957c493b9cb, type: 3}
  m_Name: UIEffectGuide
  m_EditorClassIdentifier: Assembly-CSharp-Editor::UIEffectControl.Readme
  title: "UI Effect \uC2DC\uC2A4\uD15C \uC0AC\uC6A9 \uAC00\uC774\uB4DC"
  sections:
  - heading: 
    body: "coffee.ui-effect(5.11.2) \uD328\uD0A4\uC9C0 \uC704\uC5D0 \uC62C\uB9B0
      2D UI \uC170\uC774\uB354 \uC774\uD399\uD2B8 \uB7F0\uD0C0\uC784 \uC81C\uC5B4
      \uC2A4\uD06C\uB9BD\uD2B8 \uBB36\uC74C\uC785\uB2C8\uB2E4. \uBAA8\uB4E0 \uD0C0\uC785\uC740
      <b>namespace UIEffectControl</b> \uC5D0 \uC788\uC73C\uB2C8 \uC5F0\uB3D9 \uCF54\uB4DC
      \uC0C1\uB2E8\uC5D0 using UIEffectControl; \uB97C \uCD94\uAC00\uD558\uC138\uC694."
    code: 
    note: 
  - heading: "1. \uC804\uCCB4 \uAD6C\uC870"
    body: "\uC138 \uACC4\uCE35\uC73C\uB85C \uB098\uB269\uB2C8\uB2E4.\n\n\u2022 <b>\uC2E4\uD589\uAE30(\uC11C\uBE44\uC2A4)</b>
      \u2014 UIEffectManager : IUIEffectService. UI \uC624\uBE0C\uC81D\uD2B8\uB97C
      \uBC1B\uC544 \uADF8 \uD558\uC704 \uCEE8\uD2B8\uB864\uB7EC\uB97C \uAD6C\uB3D9.
      UI \uBAA9\uB85D\uC740 \uC18C\uC720\uD558\uC9C0 \uC54A\uC74C.\n\u2022 <b>\uCEE8\uD2B8\uB864\uB7EC</b>
      \u2014 UIEffectController. \uAC1C\uBCC4 UI \uC624\uBE0C\uC81D\uD2B8\uC5D0 \uBD99\uC5B4
      \uC2E4\uC81C UIEffect / UIEffectTweener \uB97C \uC81C\uC5B4\uD558\uB294 \uD30C\uC0AC\uB4DC.\n\u2022
      <b>\uD504\uB9AC\uC14B \uC5D0\uC14B</b> \u2014 UIEffectPreset(\uD328\uD0A4\uC9C0),
      UIEffectTweenerPreset / \u2026Library. '\uC774\uB7F0 \uC774\uD399\uD2B8/\uD2B8\uC708'\uC744
      \uC774\uB984\uC73C\uB85C \uC7AC\uC0AC\uC6A9.\n\n\uAE30\uBCF8 \uD750\uB984: 
      \uC678\uBD80 \uB85C\uC9C1 \u2192 UI Manager(\uD300 \uC18C\uC720, UI \uBAA9\uB85D
      \uAD00\uB9AC) \u2192 IUIEffectService(GameObject \uC804\uB2EC) \u2192 UIEffectController.\n\n<b>\uD575\uC2EC
      \uC6D0\uCE59:</b> UI \uC758 \uC0DD\uC131\xB7\uC0AD\uC81C\xB7\uBAA9\uB85D\uC740
      \uD300\uC758 UI Manager \uAC00 \uC18C\uC720\uD569\uB2C8\uB2E4. \uC774\uD399\uD2B8
      \uC11C\uBE44\uC2A4\uB294 UI \uBAA9\uB85D\uC744 \uB4E4\uC9C0 \uC54A\uACE0, '\uC774\uBBF8
      \uCC3E\uC544\uB0B8 UI \uC758 GameObject' \uB97C \uBC1B\uC544 \uADF8 \uC624\uBE0C\uC81D\uD2B8\uC640
      \uC790\uC2DD\uC5D0 \uBD99\uC740 \uBAA8\uB4E0 UIEffectController \uB97C \uAD6C\uB3D9\uB9CC
      \uD569\uB2C8\uB2E4. \uB530\uB77C\uC11C UI \uD558\uB098\uC5D0 \uC774\uD399\uD2B8
      \uB300\uC0C1\uC774 \uC5EC\uB7EC \uAC1C\uC5EC\uB3C4 \uB8E8\uD2B8 \uC624\uBE0C\uC81D\uD2B8
      \uD558\uB098\uB9CC \uB118\uAE30\uBA74 \uB429\uB2C8\uB2E4."
    code: 
    note: "SampleUIManager.cs \uAC00 \uC774 \uD750\uB984(uiId \u2192 GameObject \uC18C\uC720
      \uD6C4 \uC11C\uBE44\uC2A4\uC5D0 \uC704\uC784)\uC758 \uCC38\uC870 \uAD6C\uD604\uC785\uB2C8\uB2E4.
      \uC2E4\uC81C UI Manager \uB97C \uB9CC\uB4E4 \uB54C \uD615\uD0DC\uB97C \uCC38\uACE0\uD558\uC138\uC694."
  - heading: "2. \uC52C \uC138\uD305"
    body: "1) \uC52C\uC5D0 UIEffectManager \uB97C \uD558\uB098 \uBC30\uCE58\uD558\uACE0
      Tweener Preset Library \uC5D0\uC14B\uC744 \uC9C0\uC815\uD569\uB2C8\uB2E4(\uC5C6\uC73C\uBA74
      \uD2B8\uC704\uB108 \uD504\uB9AC\uC14B\uC744 \uC774\uB984\uC73C\uB85C \uBABB
      \uCC3E\uC74C).\n2) \uC774\uD399\uD2B8\uB97C \uAC78 \uAC01 UI \uC624\uBE0C\uC81D\uD2B8\uC5D0
      UIEffect(\uD328\uD0A4\uC9C0) + UIEffectController \uB97C \uBD99\uC785\uB2C8\uB2E4.
      \uD2B8\uC708\uC774 \uD544\uC694\uD558\uBA74 \uAC19\uC740 \uC624\uBE0C\uC81D\uD2B8\uC5D0
      UIEffectTweener \uB3C4 \uCD94\uAC00\uD569\uB2C8\uB2E4."
    code: 
    note: "UIEffect / UIEffectController / UIEffectTweener \uB294 \uBC18\uB4DC\uC2DC
      \uAC19\uC740 GameObject \uC5D0 \uB450\uC138\uC694. \uCEE8\uD2B8\uB864\uB7EC\uAC00
      \uD2B8\uC704\uB108\uB97C \uAC19\uC740 \uC624\uBE0C\uC81D\uD2B8\uC5D0\uC11C\uB9CC
      \uCC3E\uC2B5\uB2C8\uB2E4."
  - heading: "3. \uC11C\uBE44\uC2A4(\uB9E4\uB2C8\uC800)\uB85C \uC81C\uC5B4\uD558\uAE30
      \u2014 \uAD8C\uC7A5 \uACBD\uB85C"
    body: "UIEffectManager.Instance \uB85C \uC811\uADFC\uD558\uAC70\uB098 IUIEffectService
      \uCC38\uC870\uB97C \uC8FC\uC785\uBC1B\uC544 \uC0AC\uC6A9\uD569\uB2C8\uB2E4.
      \uBAA8\uB4E0 \uBA54\uC11C\uB4DC\uB294 \uB300\uC0C1 UI \uC758 \uB8E8\uD2B8 GameObject
      \uB97C \uBC1B\uC2B5\uB2C8\uB2E4."
    code: "using UIEffectControl;\n\n// UI Manager \uAC00 \uC790\uAE30 \uBAA9\uB85D\uC5D0\uC11C
      \uCC3E\uC740 UI \uC758 GameObject \uB97C \uB118\uAE34\uB2E4.\nIUIEffectService
      fx = UIEffectManager.Instance;   // \uC52C\uC5D0 \uB9E4\uB2C8\uC800\uAC00 \uC5C6\uC73C\uBA74
      null\nif (fx != null)\n{\n    fx.ApplyPreset(hpBarRoot, \"Trauma\");   // \uD504\uB9AC\uC14B
      \uAD50\uCCB4(\uC804\uCCB4 \uAD50\uCCB4)\n    fx.PlayForward(hpBarRoot);            
      // \uD2B8\uC708 \uC815\uBC29\uD5A5 \uC7AC\uC0DD\n}"
    note: "\uBC18\uD658\uAC12 bool \uC740 '\uB300\uC0C1 \uCEE8\uD2B8\uB864\uB7EC\uB97C
      \uD558\uB098 \uC774\uC0C1 \uCC98\uB9AC\uD588\uB294\uC9C0' \uC785\uB2C8\uB2E4.
      \uC2E4\uD328 \uC2DC \uCF58\uC194\uC5D0 \uC6D0\uC778 \uACBD\uACE0\uAC00 \uB0A8\uC2B5\uB2C8\uB2E4."
  - heading: "\uD504\uB9AC\uC14B \uC801\uC6A9"
    body: "\u2022 <b>ApplyPreset(root, name, append=false)</b> \u2014 \uC774\uD399\uD2B8
      \uD504\uB9AC\uC14B \uC801\uC6A9. append=true \uBA74 \uD604\uC7AC \uC704\uC5D0
      \uACB9\uCE68(None \uC544\uB2CC \uD544\uD130\uB9CC \uB36E\uC5B4\uC500), false
      \uBA74 \uC804\uCCB4 \uAD50\uCCB4.\n\u2022 <b>ApplyTweenerPreset(root, name)</b>
      \u2014 \uD2B8\uC704\uB108 \uC124\uC815 \uC801\uC6A9. \uD504\uB9AC\uC14B\uC758
      \uC7AC\uC0DD \uC815\uCC45\uC5D0 \uB530\uB77C \uC801\uC6A9 \uC989\uC2DC \uC7AC\uC0DD\uB420
      \uC218 \uC788\uC74C.\n\n\uD504\uB9AC\uC14B \uC774\uB984\uC740 \uCEE8\uD2B8\uB864\uB7EC
      \uB85C\uCEEC \uBAA9\uB85D \u2192 \uC911\uC559 \uB808\uC9C0\uC2A4\uD2B8\uB9AC(\uD2B8\uC704\uB108\uB294
      \uB77C\uC774\uBE0C\uB7EC\uB9AC) \uC21C\uC73C\uB85C \uC870\uD68C\uB429\uB2C8\uB2E4."
    code: 
    note: 
  - heading: "\uB044\uAE30 3\uC885"
    body: "\u2022 <b>Clear(root)</b> \u2014 \uC774\uD399\uD2B8 + \uD2B8\uC708 \uB458
      \uB2E4 \uB044\uAE30(\uAE30\uBCF8 \uACBD\uB85C).\n\u2022 <b>ClearEffect(root)</b>
      \u2014 \uC774\uD399\uD2B8 \uAC12\uB9CC \uCD08\uAE30\uD654(\uB3C4\uB294 \uD2B8\uC708\uC740
      \uC720\uC9C0).\n\u2022 <b>StopTween(root)</b> \u2014 \uD2B8\uC708\uB9CC \uC815\uC9C0."
    code: 
    note: 
  - heading: "\uD2B8\uC708 \uC7AC\uC0DD \uC81C\uC5B4 (\uC628\uB514\uB9E8\uB4DC)"
    body: "\uD504\uB9AC\uC14B\uC758 '\uC801\uC6A9=\uC7AC\uC0DD'(\uC77C\uD68C\uC131)\uC73C\uB85C
      \uD45C\uD604 \uBABB \uD558\uB294 \uC591\uBC29\uD5A5\xB7\uBC18\uBCF5 \uC81C\uC5B4\uC6A9\uC785\uB2C8\uB2E4.
      \uD638\uBC84 \uD1A0\uAE00, \uD31D\uC5C5 \uAC1C\uD3D0 \uB4F1\uC5D0 \uC501\uB2C8\uB2E4.\n\nPlayForward(root,
      resetTime=true) \xB7 PlayReverse(root, resetTime=true) \xB7 TogglePlay(root)
      \xB7 StopTween(root) \xB7 PauseTween(root, pause)"
    code: "// \uBC84\uD2BC \uD638\uBC84 \uC778/\uC544\uC6C3 \uD1A0\uAE00 \uC608\uC2DC\npublic
      void OnPointerEnter() => UIEffectManager.Instance?.PlayForward(gameObject);\npublic
      void OnPointerExit()  => UIEffectManager.Instance?.PlayReverse(gameObject);"
    note: "\uC774 \uC7AC\uC0DD \uC0C1\uD0DC\uB294 \uC624\uBE0C\uC81D\uD2B8\uB97C
      \uAED0\uB2E4 \uCF1C\uBA74 \uCD08\uAE30\uD654\uB429\uB2C8\uB2E4. '\uD65C\uC131\uD654\uB420
      \uB54C\uB9C8\uB2E4 \uC790\uB3D9 \uC7AC\uC0DD'\uC774 \uD544\uC694\uD558\uBA74
      \uC7AC\uC0DD \uD328\uC2A4\uC2A4\uB8E8\uAC00 \uC544\uB2C8\uB77C \uD2B8\uC704\uB108
      \uD504\uB9AC\uC14B\uC758 Play On Enable \uB85C \uC124\uC815\uD558\uC138\uC694."
  - heading: "4. \uCEE8\uD2B8\uB864\uB7EC\uB85C \uC9C1\uC811 \uC81C\uC5B4\uD558\uAE30"
    body: "\uD2B9\uC815 UI \uB97C \uCC38\uC870\uB85C \uB4E4\uACE0 \uC788\uC744 \uB54C\uB294
      UIEffectController \uB97C \uC9C1\uC811 \uC368\uB3C4 \uB429\uB2C8\uB2E4. \uC11C\uBE44\uC2A4
      \uBA54\uC11C\uB4DC\uB294 \uACB0\uAD6D \uC774 \uCEE8\uD2B8\uB864\uB7EC\uB4E4\uC744
      \uD638\uCD9C\uD569\uB2C8\uB2E4. \uD504\uB9AC\uC14B \uC804\uD658\uC740 LoadPreset(id)
      \xB7 LoadPreset(index) \xB7 AppendPreset(id) \xB7 LoadPresetAsset(preset, append)
      \uB4F1\uC744 \uC81C\uACF5\uD558\uBA70, \uB300\uBD80\uBD84 \uB85C\uCEEC \uBAA9\uB85D\uC744
      \uBA3C\uC800 \uBCF4\uACE0 \uC5C6\uC73C\uBA74 \uC911\uC559 \uB808\uC9C0\uC2A4\uD2B8\uB9AC\uB85C
      \uD3F4\uBC31\uD569\uB2C8\uB2E4."
    code: "var controller = popup.GetComponent<UIEffectController>();\ncontroller.LoadPreset(\"Awaken\");  
      // \uB85C\uCEEC \uBAA9\uB85D \u2192 \uC911\uC559 \uB808\uC9C0\uC2A4\uD2B8\uB9AC
      \uC21C \uC870\uD68C\ncontroller.PlayForward();"
    note: 
  - heading: "\uAC1C\uBCC4 \uD30C\uB77C\uBBF8\uD130 \uC138\uD130"
    body: "SetColorIntensity, SetTransitionRate, SetGradationRotation \uB4F1\uC740
      <b>\uC790\uC8FC \uC4F0\uB294 \uC774\uD399\uD2B8 \uAC12\uC744 float \uD558\uB098
      \uB610\uB294 Color \uD558\uB098\uB9CC \uBC1B\uB294 \uC138\uD130\uB85C \uB178\uCD9C</b>\uD55C
      \uADF8\uB8F9\uC785\uB2C8\uB2E4. \uC778\uC790\uAC00 \uB2E8\uC21C\uD574 \uBC84\uD2BC/\uC2AC\uB77C\uC774\uB354\uC758
      UnityEvent(\uC608: OnValueChanged)\uC5D0 \uC778\uC2A4\uD399\uD130\uC5D0\uC11C
      \uBC14\uB85C \uBC14\uC778\uB529\uD558\uAC70\uB098, \uCF54\uB4DC\uC5D0\uC11C
      \uAC12\uC744 \uC2E4\uC2DC\uAC04 \uC870\uC815\uD560 \uB54C \uC501\uB2C8\uB2E4.
      \uC989 '\uC774\uD399\uD2B8\uC758 \uD2B9\uC815 \uAC12 \uD558\uB098\uB97C \uC9C0\uAE08
      \uC774 \uAC12\uC73C\uB85C' \uC138\uD305\uD558\uB294 \uC587\uC740 \uB798\uD37C\uC774\uBA70,
      \uC5EC\uAE30 \uC5C6\uB294 \uB098\uBA38\uC9C0 \uC18D\uC131(\uC57D 60\uC5EC \uAC1C)\uC774\uB098
      \uC138\uBC00\uD55C \uC81C\uC5B4\uB294 Effect / Tweener \uD504\uB85C\uD37C\uD2F0\uB85C
      \uC6D0\uBCF8 \uCEF4\uD3EC\uB10C\uD2B8\uC5D0 \uC9C1\uC811 \uC811\uADFC\uD569\uB2C8\uB2E4."
    code: "// \uC2AC\uB77C\uC774\uB354\uB098 \uAC8C\uC784 \uB85C\uC9C1\uC5D0\uC11C
      \uC774\uD399\uD2B8 \uAC12\uC744 \uC2E4\uC2DC\uAC04\uC73C\uB85C \uC6C0\uC9C1\uC77C
      \uB54C\ncontroller.SetColorIntensity(0.5f);\ncontroller.SetTransitionRate(progress);  
      // \uC608: \uB514\uC878\uBE0C \uC9C4\uD589\uB3C4 0~1\n\n// \uC5EC\uAE30 \uC5C6\uB294
      \uB098\uBA38\uC9C0 \uC18D\uC131\uC740 Effect \uB85C \uC9C1\uC811 \uC811\uADFC\ncontroller.Effect.gradationRotation
      = 90f;"
    note: "\uCEE8\uD2B8\uB864\uB7EC\uC758 \uBAA8\uB4E0 \uC870\uC791 \uBA54\uC11C\uB4DC\uB294
      virtual \uC774\uB77C, \uD504\uB85C\uC81D\uD2B8\uBCC4 \uB3D9\uC791\uC774 \uD544\uC694\uD558\uBA74
      \uC0C1\uC18D\uD574\uC11C \uC624\uBC84\uB77C\uC774\uB4DC\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - heading: "5. \uD504\uB9AC\uC14B \uC5D0\uC14B \uB9CC\uB4E4\uAE30"
    body: "\u2022 <b>\uC774\uD399\uD2B8 \uD504\uB9AC\uC14B(UIEffectPreset)</b> \u2014
      \uD328\uD0A4\uC9C0 \uAE30\uB2A5. \uACF5\uC6A9\uC740 Project Settings \u25B8
      UI Effect \u25B8 Runtime Presets \uC5D0 \uB4F1\uB85D\uD574 \uC774\uB984\uC73C\uB85C
      \uBD80\uB974\uACE0, \uD2B9\uC815 UI \uC804\uC6A9 \uC624\uBC84\uB77C\uC774\uB4DC\uB294
      \uCEE8\uD2B8\uB864\uB7EC \uC778\uC2A4\uD399\uD130\uC758 Presets \uBAA9\uB85D\uC5D0
      \uB4F1\uB85D\uD569\uB2C8\uB2E4(\uAC19\uC740 \uC774\uB984\uC774\uBA74 \uB85C\uCEEC
      \uC6B0\uC120).\n\n\u2022 <b>\uD2B8\uC704\uB108 \uD504\uB9AC\uC14B(UIEffectTweenerPreset)</b>
      \u2014 \uD328\uD0A4\uC9C0\uAC00 \uD2B8\uC704\uB108 \uD504\uB9AC\uC14B\uC744
      \uC9C0\uC6D0\uD558\uC9C0 \uC54A\uC544 \uBCC4\uB3C4\uB85C \uB9CC\uB4E0 \uC5D0\uC14B.
      \uACF5\uC6A9\uC740 UIEffectTweenerPresetLibrary \uC5D0 \uBAA8\uC544 \uB9E4\uB2C8\uC800\uC5D0
      \uBB3C\uB9AC\uACE0, \uC804\uC6A9\uC740 \uCEE8\uD2B8\uB864\uB7EC\uC758 Tweener
      Presets \uBAA9\uB85D\uC5D0 \uB4F1\uB85D\uD569\uB2C8\uB2E4. \uAC12\uC740 \uC190\uC73C\uB85C
      \uC62E\uAE30\uC9C0 \uC54A\uACE0, \uD2B8\uC704\uB108\uC5D0\uC11C \uB290\uB08C\uC744
      \uB9CC\uB4E0 \uB4A4 \uCEE8\uD2B8\uB864\uB7EC \uC778\uC2A4\uD399\uD130 \uD558\uB2E8
      '\uD2B8\uC704\uB108 \uD504\uB9AC\uC14B \uB3C4\uAD6C \u25B8 \uD604\uC7AC \uD2B8\uC704\uB108
      \uAC12 \u2192 \uC0C8 \uD504\uB9AC\uC14B \uC800\uC7A5' \uBC84\uD2BC\uC73C\uB85C
      \uAD7D\uC2B5\uB2C8\uB2E4. \uD2B8\uC704\uB108 \uD504\uB9AC\uC14B\uC740 \uD2B8\uC708
      \uC124\uC815 \uC678\uC5D0 Play On Apply(\uC801\uC6A9 \uC9C1\uD6C4 \uC7AC\uC0DD)\uC640
      Play On Enable(\uD65C\uC131\uD654 \uC2DC \uC7AC\uC0DD)\uC744 \uD568\uAED8 \uB4E4\uACE0
      \uC788\uC5B4, \uC801\uC6A9 \uC2DC \uCEE8\uD2B8\uB864\uB7EC\uC758 \uC7AC\uC0DD
      \uC815\uCC45\uAE4C\uC9C0 \uD55C \uBC88\uC5D0 \uC815\uD569\uB2C8\uB2E4."
    code: 
    note: 
  - heading: "6. \uC54C\uC544\uB458 \uB3D9\uC791"
    body: "\u2022 <b>\uB300\uC0C1 \uBC94\uC704</b> \u2014 \uC11C\uBE44\uC2A4\uC5D0
      \uB118\uAE34 GameObject \uC758 \uC790\uAE30 + \uBAA8\uB4E0 \uC790\uC2DD\uC5D0
      \uBD99\uC740 \uCEE8\uD2B8\uB864\uB7EC\uAC00 \uB300\uC0C1. \uD2B8\uC704\uB108
      \uC5C6\uB294 \uCEE8\uD2B8\uB864\uB7EC\uB294 \uC7AC\uC0DD \uD638\uCD9C\uC5D0\uC11C
      \uC870\uC6A9\uD788 \uAC74\uB108\uB700.\n\u2022 <b>\uB9E4\uB2C8\uC800 \uBD80\uC7AC</b>
      \u2014 UIEffectManager.Instance \uB294 \uC52C\uC5D0 \uB9E4\uB2C8\uC800\uAC00
      \uC5C6\uC73C\uBA74 \uACBD\uACE0 \uD6C4 null \uBC18\uD658(\uC790\uB3D9 \uC0DD\uC131
      \uC548 \uD568). \uD638\uCD9C \uC804 null \uCCB4\uD06C \uAD8C\uC7A5.\n\u2022
      <b>\uAE30\uBCF8 \uC815\uC9C0</b> \u2014 \uCEE8\uD2B8\uB864\uB7EC\uC758 Play
      On Enable \uAE30\uBCF8\uAC12\uC740 None \uC774\uB77C, \uD65C\uC131\uD654\uB9CC\uC73C\uB85C\uB294
      \uD2B8\uC708\uC774 \uB3CC\uC9C0 \uC54A\uACE0 \uC774\uD399\uD2B8\uC758 \uC815\uC801
      \uAC12\uC774 \uC720\uC9C0\uB428. \uCF1C\uC9C0\uC790\uB9C8\uC790 \uC6C0\uC9C1\uC5EC\uC57C
      \uD560 \uB54C\uB9CC Forward/Reverse.\n\u2022 <b>\uC52C \uC720\uC9C0</b> \u2014
      \uB9E4\uB2C8\uC800\uB294 UI \uCC38\uC870\uB97C \uB4E4\uC9C0 \uC54A\uC544 \uC52C
      \uC804\uD658\uC5D0 \uC548\uC804. \uC52C\uC744 \uB118\uACA8 \uC720\uC9C0\uD558\uB824\uBA74
      Don't Destroy On Load \uB97C \uCF1C\uACE0 \uB8E8\uD2B8 \uC624\uBE0C\uC81D\uD2B8\uB85C
      \uB458 \uAC83."
